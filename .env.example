# Flask Configuration (copy this file to .env for local use)
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False

# Database: leave as SQLite locally. Replace with the Supabase connection URL
# when using the free cloud database.
DATABASE_URL=sqlite:///qpaper_system.db

# Encryption: Generate with Python: import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())
# REQUIRED for cloud deployments. Never commit the real value.
ENCRYPTION_KEY=replace-with-a-base64-aes-256-key

# Security
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Application
APP_HOST=0.0.0.0
APP_PORT=5000
